{
  "name": "jodis-gems",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Defined here (not just via the dashboard) so it survives every future
  // deploy: this project auto-builds from Git on every push, and each build
  // reads bindings fresh from this file — a dashboard-only binding gets
  // dropped the next time new code is pushed. Learned this the hard way:
  // the D1 binding was added via the dashboard, then wiped out by the very
  // next auto-deploy, causing `env.DB` to be undefined at runtime.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jodis-gems-db",
      "database_id": "315ae58a-b583-400d-9aa4-94b0681de651"
    }
  ]
}
